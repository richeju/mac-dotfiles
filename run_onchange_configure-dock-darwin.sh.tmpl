#!/usr/bin/env bash
# Re-run when the managed helper changes.
# Hash: {{ include "dot_local/bin/executable_mac-dotfiles-configure-dock.sh.tmpl" | sha256sum }}
set -euo pipefail

if [[ "${MAC_DOTFILES_ORCHESTRATED:-0}" == "1" ]]; then
    echo "ℹ️ Dock defaults delegated to transactional convergence."
    exit 0
fi

HELPER="$HOME/.local/bin/mac-dotfiles-configure-dock.sh"
[[ -x "$HELPER" ]] || {
    echo "❌ Missing Dock helper: $HELPER" >&2
    exit 1
}
exec "$HELPER"
