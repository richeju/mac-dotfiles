#!/usr/bin/env bash
# run_onchange_install-packages-darwin.sh.tmpl
# This script runs whenever dot_Brewfile changes.
# dot_Brewfile is rendered by chezmoi as ~/.Brewfile.

# Hash: {{ include "dot_Brewfile" | sha256sum }}
set -euo pipefail

echo "📦 Installing/updating packages from Brewfile..."

if [[ "${MAC_DOTFILES_MINIMAL:-0}" == "1" ]]; then
    echo "ℹ️  Minimal setup requested; skipping full Homebrew bundle."
    echo "   Run mac-dotfiles.sh repair when ready to install/reconcile all packages."
    exit 0
fi

if ! command -v brew &> /dev/null; then
    echo "❌ Homebrew is not installed. Please run install.sh first."
    exit 1
fi

# Run brew bundle from home directory where .Brewfile is located
cd "$HOME"

if [ -f "$HOME/.Brewfile" ]; then
    echo "📋 Found Brewfile at $HOME/.Brewfile"
    brew bundle --global --verbose
    echo "✅ Packages installed/updated successfully!"
else
    echo "⚠️  No Brewfile found at $HOME/.Brewfile"
    exit 1
fi
