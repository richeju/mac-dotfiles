#!/usr/bin/env bash

set -euo pipefail

export PATH="${MAC_DOTFILES_PATH:-$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin}"

SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
STATE_DIR="${MAC_DOTFILES_STATE_DIR:-$HOME/.local/state/mac-dotfiles}"
BASELINE="${MAC_DOTFILES_COMPLIANCE_BASELINE:-$SOURCE_DIR/compliance/personal-nist-low.json}"
COMPLIANCE_DIR="$STATE_DIR/compliance"
LATEST_FILE="$COMPLIANCE_DIR/latest.json"
REMEDIATIONS_DIR="$COMPLIANCE_DIR/remediations"
FIREWALL_CMD="${MAC_DOTFILES_FIREWALL_CMD:-/usr/libexec/ApplicationFirewall/socketfilterfw}"
DEFAULTS_CMD="${MAC_DOTFILES_DEFAULTS_CMD:-defaults}"
SYSADMINCTL_CMD="${MAC_DOTFILES_SYSADMINCTL_CMD:-sysadminctl}"
SUDO_CMD="${MAC_DOTFILES_SUDO_CMD:-sudo}"
SAFE_TIMEOUT_RULE="system_settings_screensaver_timeout_enforce"
SAFE_GUEST_RULE="system_settings_guest_account_disable"
RESULTS_FILE=""
WORK_DIR=""
CHECK_DETAIL=""
JSON_MODE=0

usage() {
    cat <<'USAGE'
Usage: mac-dotfiles-compliance.sh COMMAND [options]

Commands:
  audit [--json]          Evaluate the tailored NIST baseline and save evidence.
  plan [--json]           Audit and show non-compliant or unavailable controls.
  status [--json]         Show the latest saved compliance state.
  remediate --safe [--dry-run|--yes]
                          Preview or apply the safe opt-in remediations.
  rollback [ID|latest] [--dry-run|--yes]
                          Restore settings saved by a remediation.
  explain RULE_ID         Explain one rule, its mappings, and remediation mode.
  validate-catalog        Validate baseline structure and uniqueness.

Audits never change settings. Remediation is limited to explicitly selected,
reversible controls and requires confirmation or --yes.
USAGE
}

die() {
    echo "✗ $1" >&2
    exit "${2:-1}"
}

cleanup() { [[ -z "$WORK_DIR" ]] || rm -rf "$WORK_DIR"; }
trap cleanup EXIT

require_jq() {
    command -v jq >/dev/null 2>&1 || die "jq is required"
}

is_macos() {
    [[ "${MAC_DOTFILES_PLATFORM:-$(uname -s)}" == "Darwin" ]]
}

is_target_platform() {
    local version target
    is_macos || return 1
    version="${MAC_DOTFILES_OS_VERSION:-$(sw_vers -productVersion 2>/dev/null || true)}"
    target="$(jq -r '.target.version' "$BASELINE")"
    [[ "${version%%.*}" == "$target" ]]
}

validate_catalog() {
    require_jq
    [[ -f "$BASELINE" ]] || die "Compliance baseline is missing: $BASELINE"
    jq -e '
      .schema_version == 1 and
      .kind == "mac-dotfiles-compliance-baseline" and
      .id == "personal-nist-low" and
      .mode == "audit-only" and
      .target.os == "macOS" and
      (.tailoring.parameters.screensaver_timeout_seconds | type == "number" and . > 0 and floor == .) and
      (.upstream.commit | test("^[0-9a-f]{40}$")) and
      (.rules | length >= 10) and
      ([.rules[].id] | length == (unique | length)) and
      all(.rules[];
        (.id | type == "string" and length > 0) and
        (.title | type == "string" and length > 0) and
        (.cce | test("^CCE-[0-9]+-[0-9]+$")) and
        (.controls | type == "array" and length > 0) and
        (.remediation | type == "string" and length > 0) and
        (.guidance | type == "string" and length > 0)
      )' "$BASELINE" >/dev/null
    echo "✓ Compliance catalog is valid ($(jq '.rules | length' "$BASELINE") unique rules)"
}

command_available() { command -v "$1" >/dev/null 2>&1; }

check_filevault() {
    local output
    command_available fdesetup || {
        CHECK_DETAIL="fdesetup is unavailable"
        return 3
    }
    output="$(fdesetup status 2>&1)" || {
        CHECK_DETAIL="unable to read FileVault status"
        return 3
    }
    if grep -Fq "FileVault is On" <<<"$output"; then
        CHECK_DETAIL="FileVault is enabled"
        return 0
    fi
    CHECK_DETAIL="FileVault is disabled; recovery-key planning is required before remediation"
    return 1
}

check_firewall() {
    local output
    [[ -x "$FIREWALL_CMD" ]] || {
        CHECK_DETAIL="application firewall tool is unavailable"
        return 3
    }
    output="$($FIREWALL_CMD --getglobalstate 2>&1)" || {
        CHECK_DETAIL="unable to read application firewall state"
        return 3
    }
    if grep -Eqi 'enabled|State = [12]' <<<"$output"; then
        CHECK_DETAIL="macOS application firewall is enabled"
        return 0
    fi
    CHECK_DETAIL="macOS application firewall is disabled"
    return 1
}

check_firewall_stealth() {
    local output
    [[ -x "$FIREWALL_CMD" ]] || {
        CHECK_DETAIL="application firewall tool is unavailable"
        return 3
    }
    output="$($FIREWALL_CMD --getstealthmode 2>&1)" || {
        CHECK_DETAIL="unable to read firewall stealth mode"
        return 3
    }
    if grep -Eqi 'enabled|stealth mode is on' <<<"$output"; then
        CHECK_DETAIL="firewall stealth mode is enabled"
        return 0
    fi
    CHECK_DETAIL="firewall stealth mode is disabled"
    return 1
}

check_gatekeeper() {
    local output
    command_available spctl || {
        CHECK_DETAIL="spctl is unavailable"
        return 3
    }
    output="$(spctl --status 2>&1)" || true
    if grep -Fqi "assessments enabled" <<<"$output"; then
        CHECK_DETAIL="Gatekeeper assessments are enabled"
        return 0
    fi
    CHECK_DETAIL="Gatekeeper assessments are disabled or unavailable"
    return 1
}

check_sip() {
    local output
    command_available csrutil || {
        CHECK_DETAIL="csrutil is unavailable"
        return 3
    }
    output="$(csrutil status 2>&1)" || {
        CHECK_DETAIL="unable to read SIP state"
        return 3
    }
    if grep -Fqi "status: enabled" <<<"$output"; then
        CHECK_DETAIL="System Integrity Protection is enabled"
        return 0
    fi
    CHECK_DETAIL="System Integrity Protection is not enabled"
    return 1
}

check_critical_updates() {
    local value
    command_available defaults || {
        CHECK_DETAIL="defaults is unavailable"
        return 3
    }
    value="$(defaults read /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall 2>/dev/null || true)"
    if [[ "$value" == "1" ]]; then
        CHECK_DETAIL="automatic critical security updates are enabled"
        return 0
    fi
    CHECK_DETAIL="automatic critical security updates are not explicitly enabled"
    return 1
}

check_software_current() {
    local output status=0
    command_available softwareupdate || {
        CHECK_DETAIL="softwareupdate is unavailable"
        return 3
    }
    output="$(softwareupdate -l 2>&1)" || status=$?
    if [[ "$status" -ne 0 ]]; then
        CHECK_DETAIL="software update inspection failed"
        return 3
    fi
    if grep -Eqi 'No new software available|No updates are available' <<<"$output"; then
        CHECK_DETAIL="no recommended macOS updates are pending"
        return 0
    fi
    CHECK_DETAIL="recommended macOS updates are pending"
    return 1
}

read_default() {
    "$DEFAULTS_CMD" "$@" 2>/dev/null
}

baseline_timeout_seconds() {
    jq -r '.tailoring.parameters.screensaver_timeout_seconds' "$BASELINE"
}

read_guest_account_state() {
    local output value
    if command_available "$SYSADMINCTL_CMD"; then
        output="$($SYSADMINCTL_CMD -guestAccount status 2>&1)" || return 1
        if grep -Fqi disabled <<<"$output"; then
            echo disabled
            return 0
        fi
        if grep -Fqi enabled <<<"$output"; then
            echo enabled
            return 0
        fi
        return 1
    fi
    command_available "$DEFAULTS_CMD" || return 1
    value="$(read_default read /Library/Preferences/com.apple.loginwindow GuestEnabled || true)"
    case "$value" in
        "" | 0) echo disabled ;;
        1) echo enabled ;;
        *) return 1 ;;
    esac
}

check_screensaver_timeout() {
    local value timeout_limit
    command_available "$DEFAULTS_CMD" || {
        CHECK_DETAIL="defaults is unavailable"
        return 3
    }
    timeout_limit="$(baseline_timeout_seconds)"
    value="$(read_default -currentHost read com.apple.screensaver idleTime || true)"
    if [[ "$value" =~ ^[0-9]+$ ]] && [[ "$value" -gt 0 && "$value" -le "$timeout_limit" ]]; then
        CHECK_DETAIL="inactivity timeout is ${value}s (maximum ${timeout_limit}s)"
        return 0
    fi
    CHECK_DETAIL="inactivity timeout is unset, disabled, or greater than ${timeout_limit}s"
    return 1
}

check_screensaver_password() {
    local value
    command_available defaults || {
        CHECK_DETAIL="defaults is unavailable"
        return 3
    }
    value="$(read_default read com.apple.screensaver askForPassword || true)"
    if [[ "$value" == "1" ]]; then
        CHECK_DETAIL="authentication is required after screen saver"
        return 0
    fi
    CHECK_DETAIL="authentication after screen saver is not enforced"
    return 1
}

check_screensaver_delay() {
    local value
    command_available defaults || {
        CHECK_DETAIL="defaults is unavailable"
        return 3
    }
    value="$(read_default read com.apple.screensaver askForPasswordDelay || true)"
    if [[ "$value" == "0" ]]; then
        CHECK_DETAIL="authentication is required immediately after lock"
        return 0
    fi
    CHECK_DETAIL="screen-lock authentication delay is not zero"
    return 1
}

check_automatic_login() {
    local value
    command_available defaults || {
        CHECK_DETAIL="defaults is unavailable"
        return 3
    }
    value="$(read_default read /Library/Preferences/com.apple.loginwindow autoLoginUser || true)"
    if [[ -z "$value" ]]; then
        CHECK_DETAIL="automatic login is disabled"
        return 0
    fi
    CHECK_DETAIL="automatic login is configured for a user"
    return 1
}

check_guest_account() {
    local state
    state="$(read_guest_account_state)" || {
        CHECK_DETAIL="unable to determine guest account status"
        return 3
    }
    case "$state" in
        disabled)
            CHECK_DETAIL="guest account is disabled"
            return 0
            ;;
        enabled)
            CHECK_DETAIL="guest account is enabled"
            return 1
            ;;
        *)
            CHECK_DETAIL="guest account status is unknown"
            return 3
            ;;
    esac
}

check_service_absent() {
    local service="$1" label="$2"
    command_available launchctl || {
        CHECK_DETAIL="launchctl is unavailable"
        return 3
    }
    if launchctl print "system/$service" >/dev/null 2>&1; then
        CHECK_DETAIL="$label service is running"
        return 1
    fi
    CHECK_DETAIL="$label service is not running"
    return 0
}

check_remote_management() {
    if command_available pgrep && pgrep -x ARDAgent >/dev/null 2>&1; then
        CHECK_DETAIL="Apple Remote Desktop agent is running"
        return 1
    fi
    CHECK_DETAIL="Apple Remote Desktop agent is not running"
    return 0
}

check_time_service() {
    command_available launchctl || {
        CHECK_DETAIL="launchctl is unavailable"
        return 3
    }
    if launchctl print system/com.apple.timed >/dev/null 2>&1; then
        CHECK_DETAIL="time synchronization daemon is running"
        return 0
    fi
    CHECK_DETAIL="time synchronization daemon is unavailable"
    return 1
}

evaluate_rule() {
    local id="$1"
    CHECK_DETAIL=""
    case "$id" in
        system_settings_firewall_enable) check_firewall ;;
        system_settings_firewall_stealth_mode_enable) check_firewall_stealth ;;
        os_gatekeeper_enable) check_gatekeeper ;;
        os_sip_enable) check_sip ;;
        system_settings_critical_update_install_enforce) check_critical_updates ;;
        system_settings_softwareupdate_current) check_software_current ;;
        system_settings_screensaver_timeout_enforce) check_screensaver_timeout ;;
        system_settings_screensaver_password_enforce) check_screensaver_password ;;
        system_settings_screensaver_ask_for_password_delay_enforce) check_screensaver_delay ;;
        system_settings_automatic_login_disable) check_automatic_login ;;
        system_settings_guest_account_disable) check_guest_account ;;
        system_settings_screen_sharing_disable) check_service_absent com.apple.screensharing "Screen Sharing" ;;
        system_settings_remote_management_disable) check_remote_management ;;
        system_settings_ssh_disable) check_service_absent com.openssh.sshd "Remote Login" ;;
        os_time_server_enabled) check_time_service ;;
        system_settings_filevault_enforce) check_filevault ;;
        *)
            CHECK_DETAIL="rule has no local evaluator"
            return 3
            ;;
    esac
}

record_result() {
    local id="$1" status="$2" detail="$3" rule
    rule="$(jq -c --arg id "$id" '.rules[] | select(.id == $id)' "$BASELINE")"
    jq -nc --argjson rule "$rule" --arg status "$status" --arg detail "$detail" \
        '$rule + {status:$status,detail:$detail}' >>"$RESULTS_FILE"
}

audit_rules() {
    local id result status
    while IFS= read -r id; do
        if ! is_target_platform; then
            record_result "$id" "not_applicable" "baseline targets macOS 26"
            continue
        fi
        if evaluate_rule "$id"; then
            status="pass"
        else
            result=$?
            case "$result" in
                1) status="fail" ;;
                2) status="manual" ;;
                *) status="error" ;;
            esac
        fi
        record_result "$id" "$status" "$CHECK_DETAIL"
    done < <(jq -r '.rules[].id' "$BASELINE")
}

render_text() {
    jq -r '"NIST compliance audit: \(.overall)\nBaseline: \(.baseline.id)\nPlatform: \(.platform)\nUpdated: \(.timestamp)\n\nSummary: \(.summary.pass) pass, \(.summary.fail) fail, \(.summary.error) error, \(.summary.not_applicable) not applicable\n", (.results[] | "  \(.status | ascii_upcase)\t\(.id) — \(.detail)")' "$1"
}

run_audit() {
    local timestamp platform overall pass fail error not_applicable temp latest_temp exit_status=0
    case "${1:-}" in
        "") ;;
        --json) JSON_MODE=1 ;;
        *) die "Unknown audit option: $1" 2 ;;
    esac
    validate_catalog >/dev/null
    mkdir -p "$COMPLIANCE_DIR/attestations"
    chmod 700 "$COMPLIANCE_DIR" "$COMPLIANCE_DIR/attestations"
    WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/mac-dotfiles-compliance.XXXXXX")"
    RESULTS_FILE="$WORK_DIR/results.jsonl"
    : >"$RESULTS_FILE"
    audit_rules

    pass="$(jq -s '[.[] | select(.status == "pass")] | length' "$RESULTS_FILE")"
    fail="$(jq -s '[.[] | select(.status == "fail")] | length' "$RESULTS_FILE")"
    error="$(jq -s '[.[] | select(.status == "error")] | length' "$RESULTS_FILE")"
    not_applicable="$(jq -s '[.[] | select(.status == "not_applicable")] | length' "$RESULTS_FILE")"
    if [[ "$error" -gt 0 ]]; then
        overall="error"
        exit_status=2
    elif [[ "$fail" -gt 0 ]]; then
        overall="noncompliant"
        exit_status=1
    elif [[ "$pass" -eq 0 ]]; then
        overall="not_applicable"
    else
        overall="pass"
    fi
    timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    platform="$(sw_vers -productVersion 2>/dev/null || uname -s)"
    temp="$WORK_DIR/attestation.json"
    jq -s \
        --arg timestamp "$timestamp" --arg platform "$platform" --arg overall "$overall" \
        --argjson pass "$pass" --argjson fail "$fail" --argjson error "$error" --argjson not_applicable "$not_applicable" \
        --slurpfile baseline "$BASELINE" \
        '{schema_version:1,kind:"mac-dotfiles-nist-compliance",timestamp:$timestamp,platform:$platform,overall:$overall,baseline:{id:$baseline[0].id,title:$baseline[0].title,mode:$baseline[0].mode,upstream:$baseline[0].upstream},summary:{pass:$pass,fail:$fail,error:$error,not_applicable:$not_applicable},results:.}' \
        "$RESULTS_FILE" >"$temp"
    cp "$temp" "$COMPLIANCE_DIR/attestations/${timestamp//[:]/-}.json"
    latest_temp="$LATEST_FILE.tmp.$$"
    cp "$temp" "$latest_temp"
    chmod 600 "$COMPLIANCE_DIR/attestations/${timestamp//[:]/-}.json" "$latest_temp"
    mv "$latest_temp" "$LATEST_FILE"
    if [[ "$JSON_MODE" -eq 1 ]]; then cat "$LATEST_FILE"; else render_text "$LATEST_FILE"; fi
    return "$exit_status"
}

show_status() {
    case "${1:-}" in
        "") JSON_MODE=0 ;;
        --json) JSON_MODE=1 ;;
        *) die "Unknown status option: $1" 2 ;;
    esac
    [[ -f "$LATEST_FILE" ]] || die "No compliance state found; run: mac-dotfiles.sh compliance audit"
    if [[ "$JSON_MODE" -eq 1 ]]; then cat "$LATEST_FILE"; else render_text "$LATEST_FILE"; fi
}

show_plan() {
    local audit_status=0
    case "${1:-}" in
        "") JSON_MODE=0 ;;
        --json) JSON_MODE=1 ;;
        *) die "Unknown plan option: $1" 2 ;;
    esac
    run_audit --json >/dev/null || audit_status=$?
    if [[ "$JSON_MODE" -eq 1 ]]; then
        jq '{schema_version,kind,overall,baseline,summary,actions:[.results[] | select(.status != "pass" and .status != "not_applicable") | {id,title,status,remediation,impact,guidance,controls,detail}]}' "$LATEST_FILE"
    else
        echo "NIST compliance plan"
        echo "===================="
        jq -r '.results[] | select(.status != "pass" and .status != "not_applicable") | "  [\(.status | ascii_upcase)][\(.impact)] \(.id)\n    \(.guidance)"' "$LATEST_FILE"
    fi
    return "$audit_status"
}

explain_rule() {
    local id="${1:-}" rule
    [[ -n "$id" ]] || die "Usage: compliance explain RULE_ID" 2
    validate_catalog >/dev/null
    rule="$(jq -c --arg id "$id" '.rules[] | select(.id == $id)' "$BASELINE")"
    [[ -n "$rule" ]] || die "Unknown compliance rule: $id" 2
    jq -r '"\(.title)\n\(.id) / \(.cce)\nNIST SP 800-53 Rev. 5: \(.controls | join(", "))\nCategory: \(.category)\nImpact: \(.impact)\nRemediation: \(.remediation)\n\n\(.guidance)"' <<<"$rule"
}

confirm_action() {
    local prompt="$1" assume_yes="$2" answer
    [[ "$assume_yes" -eq 0 ]] || return 0
    [[ -t 0 ]] || die "$prompt Re-run with --yes to confirm non-interactively." 2
    printf '%s [y/N] ' "$prompt"
    read -r answer
    [[ "$answer" == "y" || "$answer" == "Y" || "$answer" == "yes" || "$answer" == "YES" ]]
}

run_privileged() {
    if [[ "${MAC_DOTFILES_NO_SUDO:-0}" == "1" || "$EUID" -eq 0 ]]; then
        "$@"
    else
        "$SUDO_CMD" "$@"
    fi
}

render_remediation_preview() {
    local timeout_action="$1" guest_action="$2" timeout_limit="$3"
    echo "Safe NIST remediation preview"
    echo "============================="
    if [[ "$timeout_action" == "apply" ]]; then
        echo "  CHANGE  Set the inactivity timeout to $timeout_limit seconds"
    else
        echo "  OK      Inactivity timeout already meets the baseline"
    fi
    if [[ "$guest_action" == "apply" ]]; then
        echo "  CHANGE  Disable the macOS guest account (administrator approval required)"
    else
        echo "  OK      Guest account is already disabled"
    fi
    echo
    echo "The previous values will be saved for rollback. Firewall and FileVault are not changed."
}

restore_snapshot() {
    local snapshot="$1" idle_exists idle_value guest_state restore_status=0
    idle_exists="$(jq -r '.before.screensaver_idle_time.exists' "$snapshot")"
    idle_value="$(jq -r '.before.screensaver_idle_time.value // empty' "$snapshot")"
    guest_state="$(jq -r '.before.guest_account' "$snapshot")"

    if [[ "$idle_exists" == "true" ]]; then
        "$DEFAULTS_CMD" -currentHost write com.apple.screensaver idleTime -int "$idle_value" || restore_status=1
    else
        "$DEFAULTS_CMD" -currentHost delete com.apple.screensaver idleTime >/dev/null 2>&1 || true
    fi
    case "$guest_state" in
        enabled) run_privileged "$SYSADMINCTL_CMD" -guestAccount on || restore_status=1 ;;
        disabled) run_privileged "$SYSADMINCTL_CMD" -guestAccount off || restore_status=1 ;;
        *) restore_status=1 ;;
    esac
    return "$restore_status"
}

run_remediation() {
    local safe=0 dry_run=0 assume_yes=0 arg idle_raw idle_exists=false idle_value=null guest_state
    local timeout_action=skip guest_action=skip timeout_limit run_id run_dir snapshot timestamp apply_status=0 audit_status=0
    for arg in "$@"; do
        case "$arg" in
            --safe) safe=1 ;;
            --dry-run) dry_run=1 ;;
            --yes) assume_yes=1 ;;
            *) die "Unknown remediation option: $arg" 2 ;;
        esac
    done
    [[ "$safe" -eq 1 ]] || die "Only the curated safe set is available; use: compliance remediate --safe" 2
    [[ "$dry_run" -eq 0 || "$assume_yes" -eq 0 ]] || die "--dry-run and --yes cannot be combined" 2
    is_target_platform || die "Safe remediation is only supported on the baseline target, macOS 26" 2
    command_available "$DEFAULTS_CMD" || die "defaults is required" 2
    command_available "$SYSADMINCTL_CMD" || die "sysadminctl is required" 2

    validate_catalog >/dev/null
    timeout_limit="$(baseline_timeout_seconds)"
    idle_raw="$(read_default -currentHost read com.apple.screensaver idleTime || true)"
    if [[ "$idle_raw" =~ ^[0-9]+$ ]]; then
        idle_exists=true
        idle_value="$idle_raw"
    fi
    if [[ ! "$idle_raw" =~ ^[0-9]+$ || "$idle_raw" -eq 0 || "$idle_raw" -gt "$timeout_limit" ]]; then timeout_action=apply; fi
    guest_state="$(read_guest_account_state)" || die "Unable to determine the guest account state; no changes made" 2
    [[ "$guest_state" == enabled ]] && guest_action=apply
    render_remediation_preview "$timeout_action" "$guest_action" "$timeout_limit"
    if [[ "$timeout_action" == skip && "$guest_action" == skip ]]; then
        echo "Nothing to remediate."
        return 0
    fi
    [[ "$dry_run" -eq 0 ]] || return 0
    confirm_action "Apply these safe remediations?" "$assume_yes" || die "Remediation cancelled; no changes made" 1

    timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    run_id="${timestamp//[:]/-}-$$"
    run_dir="$REMEDIATIONS_DIR/$run_id"
    snapshot="$run_dir/state.json"
    mkdir -p "$run_dir"
    chmod 700 "$COMPLIANCE_DIR" "$REMEDIATIONS_DIR" "$run_dir"
    jq -n --arg id "$run_id" --arg timestamp "$timestamp" --argjson idle_exists "$idle_exists" \
        --argjson idle_value "$idle_value" --argjson timeout_limit "$timeout_limit" --arg guest_state "$guest_state" \
        --arg timeout_rule "$SAFE_TIMEOUT_RULE" --arg guest_rule "$SAFE_GUEST_RULE" \
        '{schema_version:1,kind:"mac-dotfiles-compliance-remediation",id:$id,status:"applying",created_at:$timestamp,target:{screensaver_idle_time:$timeout_limit},before:{screensaver_idle_time:{exists:$idle_exists,value:$idle_value},guest_account:$guest_state},actions:[$timeout_rule,$guest_rule]}' \
        >"$snapshot"
    chmod 600 "$snapshot"

    if [[ "$timeout_action" == apply ]]; then
        "$DEFAULTS_CMD" -currentHost write com.apple.screensaver idleTime -int "$timeout_limit" || apply_status=1
    fi
    if [[ "$apply_status" -eq 0 && "$guest_action" == apply ]]; then
        run_privileged "$SYSADMINCTL_CMD" -guestAccount off || apply_status=1
    fi
    if [[ "$apply_status" -eq 0 ]]; then
        run_audit --json >/dev/null || audit_status=$?
        jq -e --arg timeout_rule "$SAFE_TIMEOUT_RULE" --arg guest_rule "$SAFE_GUEST_RULE" \
            '[.results[] | select((.id == $timeout_rule or .id == $guest_rule) and .status != "pass")] | length == 0' \
            "$LATEST_FILE" >/dev/null || apply_status=1
        [[ "$audit_status" -ne 2 ]] || apply_status=1
    fi
    if [[ "$apply_status" -ne 0 ]]; then
        if restore_snapshot "$snapshot"; then
            jq '.status="rolled_back_after_failure" | .completed_at=(now | todateiso8601)' "$snapshot" >"$snapshot.tmp"
            mv "$snapshot.tmp" "$snapshot"
            chmod 600 "$snapshot"
            die "Safe remediation failed validation and the previous settings were restored"
        fi
        jq '.status="rollback_failed" | .completed_at=(now | todateiso8601)' "$snapshot" >"$snapshot.tmp"
        mv "$snapshot.tmp" "$snapshot"
        chmod 600 "$snapshot"
        die "Safe remediation failed and automatic rollback also failed; inspect: $snapshot" 2
    fi
    jq '.status="success" | .completed_at=(now | todateiso8601)' "$snapshot" >"$snapshot.tmp"
    mv "$snapshot.tmp" "$snapshot"
    chmod 600 "$snapshot"
    echo "✓ Safe remediation applied and verified"
    echo "Rollback ID: $run_id"
}

run_remediation_rollback() {
    local id=latest dry_run=0 assume_yes=0 arg snapshot run_dir
    for arg in "$@"; do
        case "$arg" in
            --dry-run) dry_run=1 ;;
            --yes) assume_yes=1 ;;
            latest) id=latest ;;
            --*) die "Unknown rollback option: $arg" 2 ;;
            *)
                [[ "$id" == latest ]] || die "Only one rollback ID may be specified" 2
                id="$arg"
                ;;
        esac
    done
    [[ "$dry_run" -eq 0 || "$assume_yes" -eq 0 ]] || die "--dry-run and --yes cannot be combined" 2
    if [[ "$id" == latest ]]; then
        run_dir="$(find "$REMEDIATIONS_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -r | while IFS= read -r candidate; do
            if jq -e '.status == "success"' "$candidate/state.json" >/dev/null 2>&1; then
                echo "$candidate"
                break
            fi
        done)"
        [[ -n "$run_dir" ]] || die "No successful remediation snapshot found" 2
    else
        [[ "$id" != */* && "$id" != *..* ]] || die "Invalid rollback ID" 2
        run_dir="$REMEDIATIONS_DIR/$id"
    fi
    snapshot="$run_dir/state.json"
    [[ -f "$snapshot" ]] || die "Remediation snapshot not found: $id" 2
    jq -e '.schema_version == 1 and .kind == "mac-dotfiles-compliance-remediation" and .status == "success" and (.before.screensaver_idle_time.exists | type == "boolean") and (if .before.screensaver_idle_time.exists then (.before.screensaver_idle_time.value | type == "number" and . >= 0) else .before.screensaver_idle_time.value == null end) and (.before.guest_account == "enabled" or .before.guest_account == "disabled")' \
        "$snapshot" >/dev/null || die "Remediation snapshot is invalid: $snapshot" 2
    echo "Compliance rollback preview"
    echo "==========================="
    jq -r '"  RESTORE Inactivity timeout: " + (if .before.screensaver_idle_time.exists then (.before.screensaver_idle_time.value | tostring) + " seconds" else "unset" end), "  RESTORE Guest account: " + .before.guest_account' "$snapshot"
    [[ "$dry_run" -eq 0 ]] || return 0
    confirm_action "Restore these previous settings?" "$assume_yes" || die "Rollback cancelled; no changes made" 1
    restore_snapshot "$snapshot" || die "Rollback failed; inspect: $snapshot" 2
    jq '.status="rolled_back" | .rolled_back_at=(now | todateiso8601)' "$snapshot" >"$snapshot.tmp"
    mv "$snapshot.tmp" "$snapshot"
    chmod 600 "$snapshot"
    run_audit --json >/dev/null || true
    echo "✓ Previous compliance settings restored"
}

command="${1:-status}"
shift || true
case "$command" in
    audit) run_audit "$@" ;;
    plan) show_plan "$@" ;;
    status) show_status "$@" ;;
    remediate) run_remediation "$@" ;;
    rollback) run_remediation_rollback "$@" ;;
    explain) explain_rule "$@" ;;
    validate-catalog)
        [[ $# -eq 0 ]] || die "validate-catalog takes no arguments" 2
        validate_catalog
        ;;
    help | -h | --help) usage ;;
    *) die "Unknown compliance command: $command" 2 ;;
esac
