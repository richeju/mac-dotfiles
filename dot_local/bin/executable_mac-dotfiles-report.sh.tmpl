#!/usr/bin/env bash

set -euo pipefail

STATE_DIR="$HOME/.local/state/mac-dotfiles"
MAINTENANCE_LOG="$STATE_DIR/maintenance.log"
LAUNCHD_LOG="$STATE_DIR/launchd.log"
CHEZMOI_SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
LAUNCH_AGENT="$HOME/Library/LaunchAgents/com.chezmoi.mac-dotfiles.maintenance.plist"
CONVERGE_SCRIPT="$HOME/.local/bin/mac-dotfiles-converge.sh"
TRANSACTIONS_DIR="$STATE_DIR/transactions"
MIGRATE_SCRIPT="$HOME/.local/bin/mac-dotfiles-migrate.sh"
LATEST_CERTIFICATION="$STATE_DIR/certifications/latest.json"
RECOVERY_DIR="$STATE_DIR/recovery-snapshots"
WATCHDOG_STATE="$STATE_DIR/watchdog/state.json"
CERTIFIED_UPDATE_STATE="$STATE_DIR/certified-update-state.json"
COMPLIANCE_STATE="$STATE_DIR/compliance/latest.json"
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/mac-dotfiles-report.XXXXXX")"

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g'
}

capture_command() {
    local name="$1"
    shift

    "$@" >"$TMP_DIR/$name.out" 2>"$TMP_DIR/$name.err"
}

print_command_value() {
    local label="$1"
    shift
    local key
    key="$(echo "$label" | tr -c '[:alnum:]' '_' | tr '[:upper:]' '[:lower:]')"

    if capture_command "$key" "$@"; then
        local value
        value="$(head -n 1 "$TMP_DIR/$key.out")"
        if [[ -n "$value" ]]; then
            printf -- "- %s: \`%s\`\n" "$label" "$value"
        else
            printf -- "- %s: OK\n" "$label"
        fi
    else
        local error
        error="$(head -n 1 "$TMP_DIR/$key.err")"
        if [[ -n "$error" ]]; then
            printf -- "- %s: warning - %s\n" "$label" "$error"
        else
            printf -- "- %s: unavailable\n" "$label"
        fi
    fi
}

print_section_command() {
    local heading="$1"
    shift

    echo
    echo "## $heading"
    echo
    echo '```text'
    "$@" 2>&1 | strip_ansi || true
    echo '```'
}

print_file_tail() {
    local heading="$1"
    local file="$2"
    local lines="${3:-40}"

    echo
    echo "## $heading"
    echo
    if [[ -f "$file" ]]; then
        echo '```text'
        tail -n "$lines" "$file"
        echo '```'
    else
        echo "No log file found at \`$file\`."
    fi
}

bundle_status() {
    if ! command_exists brew; then
        echo "Homebrew is missing."
        return 1
    fi

    brew bundle check --global
}

launch_agent_status() {
    if [[ -f "$LAUNCH_AGENT" ]]; then
        echo "plist: installed"
    else
        echo "plist: missing"
    fi

    if command_exists launchctl; then
        if launchctl print "gui/$(id -u)/com.chezmoi.mac-dotfiles.maintenance" >/dev/null 2>&1; then
            echo "launchctl: loaded"
        else
            echo "launchctl: not loaded"
        fi
    else
        echo "launchctl: unavailable"
    fi
}

echo "# mac-dotfiles report"
echo
echo "Generated: $(date '+%Y-%m-%d %H:%M:%S %Z')"

echo
echo "## System"
echo
print_command_value "macOS" sw_vers -productVersion
print_command_value "Build" sw_vers -buildVersion
print_command_value "Architecture" uname -m
print_command_value "Host" hostname

echo
echo "## Tooling"
echo
if command_exists brew; then
    print_command_value "Homebrew" brew --version
    print_command_value "Homebrew prefix" brew --prefix
else
    echo "- Homebrew: missing"
fi

if command_exists chezmoi; then
    print_command_value "chezmoi" chezmoi --version
else
    echo "- chezmoi: missing"
fi

if command_exists git; then
    print_command_value "Git" git --version
else
    echo "- Git: missing"
fi

if command_exists gh; then
    print_command_value "GitHub CLI" gh --version
    if capture_command "gh-auth" gh auth status; then
        echo "- GitHub auth: configured"
    else
        echo "- GitHub auth: warning"
    fi
else
    echo "- GitHub CLI: missing"
fi

if command_exists node; then
    print_command_value "Node" node --version
else
    echo "- Node: missing"
fi

echo
echo "## Homebrew"
echo
if command_exists brew; then
    if capture_command "bundle" bundle_status; then
        echo "- Bundle: satisfied"
    else
        echo "- Bundle: warning"
    fi
    sed 's/^/  /' "$TMP_DIR/bundle.out"

    echo
    echo "### Brewfile Formulae"
    echo
    echo '```text'
    brew bundle list --global --formula 2>/dev/null || true
    echo '```'

    echo
    echo "### Brewfile Casks"
    echo
    echo '```text'
    brew bundle list --global --cask 2>/dev/null || true
    echo '```'

    print_section_command "Outdated Homebrew Items" brew outdated --greedy --verbose
else
    echo "Homebrew is not available."
fi

echo
echo "## Dotfiles"
echo
if command_exists chezmoi; then
    if [[ -d "$CHEZMOI_SOURCE_DIR" ]]; then
        echo "- Source: \`$CHEZMOI_SOURCE_DIR\`"
    else
        echo "- Source: missing at \`$CHEZMOI_SOURCE_DIR\`"
    fi

    if [[ -z "$(chezmoi diff 2>/dev/null)" ]]; then
        echo "- Pending changes: none"
    else
        echo "- Pending changes: yes"
    fi
else
    echo "chezmoi is not available."
fi

echo
echo "## Desired State"
echo
if [[ -x "$CONVERGE_SCRIPT" ]]; then
    profile="$($CONVERGE_SCRIPT profile current 2>/dev/null || echo unknown)"
    echo "- Active profile: \`$profile\`"
    latest_transaction=""
    if [[ -d "$TRANSACTIONS_DIR" ]]; then
        latest_transaction="$(find "$TRANSACTIONS_DIR" -mindepth 1 -maxdepth 1 -type d | sort -r | head -n 1)"
    fi
    if [[ -n "$latest_transaction" && -f "$latest_transaction/status.env" ]]; then
        transaction_status="$(awk -F= '$1 == "status" {print $2}' "$latest_transaction/status.env")"
        echo "- Latest transaction: \`${latest_transaction##*/}\` ($transaction_status)"
    else
        echo "- Latest transaction: none"
    fi
else
    echo "- Convergence engine: unavailable"
fi
if [[ -x "$MIGRATE_SCRIPT" ]]; then
    migration_status="$($MIGRATE_SCRIPT status --json 2>/dev/null || true)"
    if [[ -n "$migration_status" ]]; then
        echo "- Schema: $(jq -r '"\(.current)/\(.desired)"' <<<"$migration_status")"
    fi
fi
if [[ -f "$LATEST_CERTIFICATION" ]]; then
    echo "- Latest certification: $(jq -r '"\(.overall) (`\(.commit[0:7])`, \(.timestamp))"' "$LATEST_CERTIFICATION")"
else
    echo "- Latest certification: none"
fi
if [[ -f "$CERTIFIED_UPDATE_STATE" ]]; then
    echo "- Certified update: $(jq -r '"\(.status) (candidate `\(.candidate_commit[0:7])`, last known good `\(.last_known_good[0:7])`)"' "$CERTIFIED_UPDATE_STATE" 2>/dev/null || echo invalid)"
else
    echo "- Certified update: none"
fi
if [[ -f "$COMPLIANCE_STATE" ]]; then
    echo "- NIST compliance: $(jq -r '"\(.overall) (\(.summary.pass) pass, \(.summary.fail) findings, \(.summary.error) errors; \(.timestamp))"' "$COMPLIANCE_STATE" 2>/dev/null || echo invalid)"
else
    echo "- NIST compliance: no audit recorded"
fi
latest_recovery="$(find "$RECOVERY_DIR" -maxdepth 1 -type f \( -name '*.tar.gz' -o -name '*.tar.gz.enc' \) 2>/dev/null | sort | tail -n 1 || true)"
if [[ -n "$latest_recovery" ]]; then
    echo "- Latest recovery snapshot: $(basename "$latest_recovery") ($(du -h "$latest_recovery" | awk '{print $1}'))"
else
    echo "- Latest recovery snapshot: none"
fi
if [[ -f "$WATCHDOG_STATE" ]]; then
    echo "- Watchdog: $(jq -r '"\(.status) (\(.updated_at))"' "$WATCHDOG_STATE" 2>/dev/null || echo invalid)"
else
    echo "- Watchdog: no state recorded"
fi

echo
echo "## Maintenance"
echo
if [[ -x "$HOME/.local/bin/mac-dotfiles-maintenance.sh" ]]; then
    echo "- Script: installed"
else
    echo "- Script: missing or not executable"
fi
launch_agent_status | sed 's/^/- /'

if [[ -x "$CHEZMOI_SOURCE_DIR/doctor.sh" ]]; then
    print_section_command "Doctor" "$CHEZMOI_SOURCE_DIR/doctor.sh" --markdown
else
    echo
    echo "## Doctor"
    echo
    echo "No executable doctor script found at \`$CHEZMOI_SOURCE_DIR/doctor.sh\`."
fi

print_file_tail "Last Maintenance Log" "$MAINTENANCE_LOG" 60
print_file_tail "Last LaunchAgent Log" "$LAUNCHD_LOG" 40
