#!/usr/bin/env bash

set -euo pipefail

CHEZMOI_SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
INSTALL_SCRIPT="$CHEZMOI_SOURCE_DIR/install.sh"
DOCTOR_SCRIPT="$CHEZMOI_SOURCE_DIR/doctor.sh"

usage() {
    cat <<'USAGE'
Usage: mac-dotfiles.sh [command]

Commands:
  menu          Show the interactive menu
  verify        Audit machine readiness without changing anything
  repair        Reconcile dotfiles, packages, health checks, and report
  safe-update   Run update with before/after reports and backups
  certified-update  Certify a candidate, then apply it transactionally
  compliance    Audit the tailored NIST baseline and inspect evidence
  rollback      Restore files from a safe-update backup
  history       List or prune safe-update and rollback history
  update        Run the certified transactional update
  raw-update    Pull and apply directly with chezmoi (advanced escape hatch)
  report        Generate a Markdown machine report
  doctor        Run the repository health check
  explain       Explain doctor warnings and suggested fixes
  maintenance   Run dotfiles/Homebrew maintenance
  diff          Show chezmoi diff
  profile       List, inspect, or select a declarative machine profile
  plan          Preview desired-state changes without modifying the Mac
  drift         Detect whether the Mac differs from its desired state
  converge      Apply a transactional convergence with automatic rollback
  validate      Validate blocking desired-state invariants
  transactions  List convergence transaction history
  tx-rollback   Restore a convergence transaction snapshot
  migrate       Show, plan, apply, or check versioned migrations
  certify       Generate a reproducible machine certification attestation
  recovery      Create, inspect, verify, or restore recovery snapshots
  status        Show the latest proactive health state
  watch         Run, inspect, or test the proactive watchdog
  help          Show this help
USAGE
}

run_if_executable() {
    local path="$1"
    shift

    if [[ ! -x "$path" ]]; then
        echo "Missing executable: $path" >&2
        return 1
    fi

    "$path" "$@"
}

# Helper names are internal; user arguments stay in "$@".
run_managed_script() {
    local name="$1"
    shift
    run_if_executable "$HOME/.local/bin/mac-dotfiles-$name.sh" "$@"
}

require_chezmoi() {
    if ! command -v chezmoi >/dev/null 2>&1; then
        echo "Missing command: chezmoi" >&2
        return 1
    fi
}

run_chezmoi() {
    require_chezmoi
    chezmoi "$@"
}

run_repair() {
    local report_target="${1:-$HOME/mac-dotfiles-repair-report.md}"
    local doctor_status=0

    require_chezmoi

    echo "==> Running certified desired-state update"
    run_managed_script certified-update run

    echo "==> Running doctor auto-fixes"
    run_if_executable "$DOCTOR_SCRIPT" --fix || doctor_status=$?

    echo "==> Writing repair report"
    run_report "$report_target"

    if [[ "$doctor_status" -ne 0 ]]; then
        echo "Doctor completed with warnings. Review the report for remaining manual steps." >&2
        return "$doctor_status"
    fi
}

run_report() {
    local target="${1:-$HOME/mac-dotfiles-report.md}"
    run_managed_script report >"$target"
    echo "Report written to $target"
}

run_profile_menu() {
    local profile
    dispatch_command profile list
    echo
    printf "New profile (leave empty to keep current): "
    IFS= read -r profile
    [[ -z "$profile" ]] && return 0
    dispatch_command profile set "$profile"
}

show_menu() {
    cat <<'MENU'
mac-dotfiles
============

1. Verify machine readiness
2. Repair/reconcile this Mac
3. Safe update with backups
4. Roll back a safe update
5. Show backup history
6. Run certified transactional update
7. Generate machine report
8. Run doctor
9. Explain doctor warnings
10. Run maintenance
11. Show chezmoi diff
12. Show desired-state plan
13. Show configuration drift
14. Converge this Mac transactionally
15. Manage machine profile
16. Show/apply schema migrations
17. Certify this Mac
18. Disaster recovery snapshots
19. Show proactive health status
20. Audit tailored NIST compliance
0. Exit

MENU
    printf "Choose an option: "
}

run_menu() {
    local choice
    while true; do
        show_menu
        IFS= read -r choice
        echo

        case "$choice" in
            1) dispatch_command verify ;;
            2) dispatch_command repair ;;
            3) dispatch_command safe-update ;;
            4) dispatch_command rollback ;;
            5) dispatch_command history ;;
            6) dispatch_command update ;;
            7) dispatch_command report ;;
            8) dispatch_command doctor ;;
            9) dispatch_command explain ;;
            10) dispatch_command maintenance ;;
            11) dispatch_command diff ;;
            12) dispatch_command plan ;;
            13) dispatch_command drift || true ;;
            14) dispatch_command converge ;;
            15) run_profile_menu ;;
            16) dispatch_command migrate plan ;;
            17) dispatch_command certify ;;
            18) dispatch_command recovery list ;;
            19) dispatch_command status ;;
            20) dispatch_command compliance audit ;;
            0 | q | quit | exit)
                echo "Bye."
                return 0
                ;;
            *) echo "Unknown option: $choice" >&2 ;;
        esac

        echo
        printf "Press Enter to continue..."
        IFS= read -r _
        echo
    done
}

# Keep one routing table for CLI calls and interactive menu actions.
dispatch_command() {
    local command="${1:-menu}"
    shift || true

    case "$command" in
        menu) run_menu ;;
        verify) run_if_executable "$INSTALL_SCRIPT" --verify ;;
        repair | reconcile) run_repair "$@" ;;
        safe-update | certified-update | compliance | rollback | history | maintenance | migrate | certify | recovery)
            run_managed_script "$command" "$@"
            ;;
        update) run_managed_script certified-update run ;;
        raw-update) run_chezmoi update --apply ;;
        report) run_report "$@" ;;
        doctor) run_if_executable "$DOCTOR_SCRIPT" "$@" ;;
        explain) run_if_executable "$DOCTOR_SCRIPT" --explain ;;
        diff) run_chezmoi diff ;;
        profile | plan | drift | converge | validate | transactions)
            run_managed_script converge "$command" "$@"
            ;;
        tx-rollback) run_managed_script converge rollback "$@" ;;
        status) run_managed_script watchdog status "$@" ;;
        watch | watchdog) run_managed_script watchdog "$@" ;;
        help | -h | --help) usage ;;
        *)
            echo "Unknown command: $command" >&2
            usage >&2
            return 2
            ;;
    esac
}

dispatch_command "$@"
