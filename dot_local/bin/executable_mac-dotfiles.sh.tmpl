#!/usr/bin/env bash

set -euo pipefail

CHEZMOI_SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
INSTALL_SCRIPT="$CHEZMOI_SOURCE_DIR/install.sh"
DOCTOR_SCRIPT="$CHEZMOI_SOURCE_DIR/doctor.sh"
REPORT_SCRIPT="$HOME/.local/bin/mac-dotfiles-report.sh"
SAFE_UPDATE_SCRIPT="$HOME/.local/bin/mac-dotfiles-safe-update.sh"
ROLLBACK_SCRIPT="$HOME/.local/bin/mac-dotfiles-rollback.sh"
HISTORY_SCRIPT="$HOME/.local/bin/mac-dotfiles-history.sh"
MAINTENANCE_SCRIPT="$HOME/.local/bin/mac-dotfiles-maintenance.sh"
CONVERGE_SCRIPT="$HOME/.local/bin/mac-dotfiles-converge.sh"
MIGRATE_SCRIPT="$HOME/.local/bin/mac-dotfiles-migrate.sh"
CERTIFY_SCRIPT="$HOME/.local/bin/mac-dotfiles-certify.sh"

usage() {
    cat <<'USAGE'
Usage: mac-dotfiles.sh [command]

Commands:
  menu          Show the interactive menu
  verify        Audit machine readiness without changing anything
  repair        Reconcile dotfiles, packages, health checks, and report
  safe-update   Run update with before/after reports and backups
  rollback      Restore files from a safe-update backup
  history       List or prune safe-update and rollback history
  update        Run chezmoi update --apply
  report        Generate a Markdown machine report
  doctor        Run the repository health check
  explain       Explain doctor warnings and suggested fixes
  maintenance   Run dotfiles/Homebrew maintenance
  diff          Show chezmoi diff
  profile       List, inspect, or select a declarative machine profile
  plan          Preview desired-state changes without modifying the Mac
  drift         Detect whether the Mac differs from its desired state
  converge      Apply a transactional convergence with automatic rollback
  validate      Validate blocking desired-state invariants
  transactions  List convergence transaction history
  tx-rollback   Restore a convergence transaction snapshot
  migrate       Show, plan, apply, or check versioned migrations
  certify       Generate a reproducible machine certification attestation
  help          Show this help
USAGE
}

run_if_executable() {
    local path="$1"
    shift

    if [[ ! -x "$path" ]]; then
        echo "Missing executable: $path" >&2
        return 1
    fi

    "$path" "$@"
}

run_verify() {
    run_if_executable "$INSTALL_SCRIPT" --verify
}

run_repair() {
    local report_target="${1:-$HOME/mac-dotfiles-repair-report.md}"
    local doctor_status=0

    if ! command -v chezmoi >/dev/null 2>&1; then
        echo "Missing command: chezmoi" >&2
        return 1
    fi

    echo "==> Updating desired-state source"
    chezmoi git pull -- --ff-only </dev/null

    echo "==> Running transactional convergence"
    run_if_executable "$CONVERGE_SCRIPT" converge --yes

    echo "==> Running doctor auto-fixes"
    run_if_executable "$DOCTOR_SCRIPT" --fix || doctor_status=$?

    echo "==> Writing repair report"
    run_if_executable "$REPORT_SCRIPT" >"$report_target"
    echo "Report written to $report_target"

    if [[ "$doctor_status" -ne 0 ]]; then
        echo "Doctor completed with warnings. Review the report for remaining manual steps." >&2
        return "$doctor_status"
    fi
}

run_safe_update() {
    run_if_executable "$SAFE_UPDATE_SCRIPT" "$@"
}

run_rollback() {
    run_if_executable "$ROLLBACK_SCRIPT" "$@"
}

run_history() {
    run_if_executable "$HISTORY_SCRIPT" "$@"
}

run_update() {
    if ! command -v chezmoi >/dev/null 2>&1; then
        echo "Missing command: chezmoi" >&2
        return 1
    fi

    chezmoi update --apply
}

run_report() {
    local target="${1:-$HOME/mac-dotfiles-report.md}"
    run_if_executable "$REPORT_SCRIPT" >"$target"
    echo "Report written to $target"
}

run_doctor() {
    run_if_executable "$DOCTOR_SCRIPT" "$@"
}

run_explain() {
    run_if_executable "$DOCTOR_SCRIPT" --explain
}

run_maintenance() {
    run_if_executable "$MAINTENANCE_SCRIPT" "$@"
}

run_diff() {
    if ! command -v chezmoi >/dev/null 2>&1; then
        echo "Missing command: chezmoi" >&2
        return 1
    fi

    chezmoi diff
}

run_convergence_command() {
    local command="$1"
    shift
    run_if_executable "$CONVERGE_SCRIPT" "$command" "$@"
}

run_profile_menu() {
    local profile
    run_convergence_command profile list
    echo
    printf "New profile (leave empty to keep current): "
    IFS= read -r profile
    [[ -z "$profile" ]] && return 0
    run_convergence_command profile set "$profile"
}

show_menu() {
    cat <<'MENU'
mac-dotfiles
============

1. Verify machine readiness
2. Repair/reconcile this Mac
3. Safe update with backups
4. Roll back a safe update
5. Show backup history
6. Update dotfiles
7. Generate machine report
8. Run doctor
9. Explain doctor warnings
10. Run maintenance
11. Show chezmoi diff
12. Show desired-state plan
13. Show configuration drift
14. Converge this Mac transactionally
15. Manage machine profile
16. Show/apply schema migrations
17. Certify this Mac
0. Exit

MENU
    printf "Choose an option: "
}

run_menu() {
    local choice
    while true; do
        show_menu
        IFS= read -r choice
        echo

        case "$choice" in
            1) run_verify ;;
            2) run_repair ;;
            3) run_safe_update ;;
            4) run_rollback ;;
            5) run_history ;;
            6) run_update ;;
            7) run_report ;;
            8) run_doctor ;;
            9) run_explain ;;
            10) run_maintenance ;;
            11) run_diff ;;
            12) run_convergence_command plan ;;
            13) run_convergence_command drift || true ;;
            14) run_convergence_command converge ;;
            15) run_profile_menu ;;
            16) run_if_executable "$MIGRATE_SCRIPT" plan ;;
            17) run_if_executable "$CERTIFY_SCRIPT" ;;
            0 | q | quit | exit)
                echo "Bye."
                return 0
                ;;
            *) echo "Unknown option: $choice" >&2 ;;
        esac

        echo
        printf "Press Enter to continue..."
        IFS= read -r _
        echo
    done
}

command="${1:-menu}"
shift || true

case "$command" in
    menu) run_menu ;;
    verify) run_verify "$@" ;;
    repair | reconcile) run_repair "$@" ;;
    safe-update) run_safe_update "$@" ;;
    rollback) run_rollback "$@" ;;
    history) run_history "$@" ;;
    update) run_update "$@" ;;
    report) run_report "$@" ;;
    doctor) run_doctor "$@" ;;
    explain) run_explain "$@" ;;
    maintenance) run_maintenance "$@" ;;
    diff) run_diff "$@" ;;
    profile) run_convergence_command profile "$@" ;;
    plan) run_convergence_command plan "$@" ;;
    drift) run_convergence_command drift "$@" ;;
    converge) run_convergence_command converge "$@" ;;
    validate) run_convergence_command validate "$@" ;;
    transactions) run_convergence_command transactions "$@" ;;
    tx-rollback) run_convergence_command rollback "$@" ;;
    migrate) run_if_executable "$MIGRATE_SCRIPT" "$@" ;;
    certify) run_if_executable "$CERTIFY_SCRIPT" "$@" ;;
    help | -h | --help) usage ;;
    *)
        echo "Unknown command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
