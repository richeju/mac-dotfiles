#!/usr/bin/env bash

set -euo pipefail

# launchd starts jobs with a minimal PATH and does not read shell profiles.
export PATH="${MAC_DOTFILES_PATH:-$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin}"

LOG_DIR="$HOME/.local/state/mac-dotfiles"
LOG_FILE="$LOG_DIR/maintenance.log"
STATUS_FILE="$LOG_DIR/maintenance-status.json"
LOCK_DIR="$LOG_DIR/operation.lock"
SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
CERTIFICATION_FILE="$LOG_DIR/certifications/latest.json"
AUTO_CHEZMOI_UPDATE="${AUTO_CHEZMOI_UPDATE:-1}"
BREW_MAINTENANCE_SCRIPT="$HOME/.local/bin/mac-dotfiles-brew-maintenance.sh"
CERTIFY_SCRIPT="$HOME/.local/bin/mac-dotfiles-certify.sh"
WATCHDOG_SCRIPT="$HOME/.local/bin/mac-dotfiles-watchdog.sh"
maintenance_work_done=0
certification_failed=0

mkdir -p "$LOG_DIR"

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    echo "⚠️  Maintenance already running (lock: $LOCK_DIR), skipping"
    exit 0
fi
echo "$$" >"$LOCK_DIR/pid"

cleanup_lock() {
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
}

write_maintenance_status() {
    local exit_status="$1" timestamp epoch temp
    timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    epoch="$(date '+%s')"
    temp="$STATUS_FILE.tmp.$$"
    printf '{"schema_version":1,"exit_status":%d,"updated_at":"%s","updated_at_epoch":%d}\n' \
        "$exit_status" "$timestamp" "$epoch" >"$temp"
    chmod 600 "$temp"
    mv "$temp" "$STATUS_FILE"
}

current_source_commit() {
    git -C "$SOURCE_DIR" rev-parse HEAD 2>/dev/null
}

certification_matches_commit() {
    local commit="$1"
    [[ -f "$CERTIFICATION_FILE" ]] || return 1
    jq -e --arg commit "$commit" \
        '.schema_version == 1 and .kind == "mac-dotfiles-certification" and .overall == "pass" and .commit == $commit' \
        "$CERTIFICATION_FILE" >/dev/null 2>&1
}

certify_updated_source() {
    local previous_commit="$1" current_commit
    if ! current_commit="$(current_source_commit)"; then
        echo "⚠️  Current dotfiles commit is unavailable; skipping automatic certification"
        return 0
    fi
    if [[ "$current_commit" == "$previous_commit" ]] && certification_matches_commit "$current_commit"; then
        echo "🧪 Certification already matches the current commit"
        return 0
    fi
    if [[ ! -x "$CERTIFY_SCRIPT" ]]; then
        echo "❌ Missing certification script: $CERTIFY_SCRIPT"
        return 1
    fi
    if [[ -n "$previous_commit" && "$current_commit" != "$previous_commit" ]]; then
        echo "🧪 Dotfiles changed; certifying commit ${current_commit:0:7}..."
    else
        echo "🧪 Certifying current dotfiles commit ${current_commit:0:7}..."
    fi
    if ! "$CERTIFY_SCRIPT" --skip-live; then
        echo "❌ Automatic certification failed for commit ${current_commit:0:7}"
        return 1
    fi
    if ! certification_matches_commit "$current_commit"; then
        echo "❌ Automatic certification did not produce a matching passing attestation"
        return 1
    fi
}

maintenance_exit() {
    local exit_status=$?
    cleanup_lock
    trap - EXIT
    if ! write_maintenance_status "$exit_status"; then
        echo "⚠️  Failed to persist maintenance status: $STATUS_FILE"
    fi
    if [[ -x "$WATCHDOG_SCRIPT" ]]; then
        MAC_DOTFILES_MAINTENANCE_EXIT_STATUS="$exit_status" "$WATCHDOG_SCRIPT" run || true
    fi
    exit "$exit_status"
}
trap maintenance_exit EXIT

exec > >(tee -a "$LOG_FILE") 2>&1

echo ""
echo "===== $(date '+%Y-%m-%d %H:%M:%S') :: mac-dotfiles maintenance ====="

if [[ "$AUTO_CHEZMOI_UPDATE" == "1" ]]; then
    if command -v chezmoi >/dev/null 2>&1; then
        source_commit_before="$(current_source_commit || true)"
        echo "🧩 Syncing dotfiles with chezmoi..."
        if ! chezmoi update --apply; then
            echo "⚠️  chezmoi update failed. Continuing with Homebrew maintenance."
        else
            maintenance_work_done=1
            if ! certify_updated_source "$source_commit_before"; then
                certification_failed=1
            fi
        fi
    else
        echo "⚠️  chezmoi not installed, skipping dotfiles sync"
    fi
else
    echo "ℹ️  AUTO_CHEZMOI_UPDATE=0, skipping dotfiles sync"
fi

if [[ ! -f "$BREW_MAINTENANCE_SCRIPT" ]]; then
    echo "⚠️  Missing helper script: $BREW_MAINTENANCE_SCRIPT"
    echo "   Run chezmoi apply to install all managed scripts, then retry."
    exit 1
fi

# shellcheck source=/dev/null
source "$BREW_MAINTENANCE_SCRIPT"
if command -v brew >/dev/null 2>&1; then
    run_brew_maintenance
    maintenance_work_done=1
else
    echo "⚠️  Homebrew is unavailable in PATH; maintenance is incomplete"
fi

if [[ "$maintenance_work_done" -eq 0 ]]; then
    echo "❌ No maintenance task could run"
    exit 1
fi

if [[ "$certification_failed" -eq 1 ]]; then
    echo "❌ Maintenance completed with an automatic certification failure"
    exit 1
fi

echo "✅ Maintenance completed"
