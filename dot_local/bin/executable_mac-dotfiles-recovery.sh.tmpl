#!/usr/bin/env bash

set -euo pipefail
umask 077

STATE_DIR="${MAC_DOTFILES_STATE_DIR:-$HOME/.local/state/mac-dotfiles}"
SNAPSHOT_DIR="${MAC_DOTFILES_SNAPSHOT_DIR:-$STATE_DIR/recovery-snapshots}"
LOCK_DIR="$STATE_DIR/operation.lock"
FORMAT_VERSION=1
ASSUME_YES=0
ENCRYPT=0
LOCK_HELD=0
TEMP_DIRS=()
NEW_TEMP_DIR=""
PARTIAL_OUTPUT=""

usage() {
    cat <<'USAGE'
Usage: mac-dotfiles-recovery.sh COMMAND [OPTIONS]

Commands:
  create [--output PATH] [--encrypt]  Create a portable recovery snapshot.
  list                                List locally stored snapshots.
  inspect SNAPSHOT                    Show snapshot metadata and contents.
  verify SNAPSHOT                     Verify format and payload checksums.
  restore SNAPSHOT [--dry-run] [--yes]
                                      Restore transactionally with rollback.

Snapshots contain an explicit configuration allowlist and Homebrew inventories.
Passwords, SSH keys, tokens, browser data, and application data are excluded.
Encrypted snapshots use OpenSSL AES-256-CBC with PBKDF2.
USAGE
}

die() {
    echo "✗ $1" >&2
    exit "${2:-1}"
}

sha256_file() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        sha256sum "$1" | awk '{print $1}'
    fi
}

cleanup() {
    local path
    [[ "$LOCK_HELD" -eq 0 ]] || rm -rf "$LOCK_DIR"
    for path in "${TEMP_DIRS[@]}"; do
        rm -rf "$path"
    done
    [[ -z "$PARTIAL_OUTPUT" ]] || rm -f "$PARTIAL_OUTPUT"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

new_temp_dir() {
    local prefix="$1"
    NEW_TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/$prefix.XXXXXX")"
    TEMP_DIRS+=("$NEW_TEMP_DIR")
}

acquire_lock() {
    local owner=""
    mkdir -p "$STATE_DIR"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        [[ -f "$LOCK_DIR/pid" ]] && owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
        if [[ "$owner" =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
            die "Another mac-dotfiles operation is running (PID $owner)"
        fi
        rm -rf "$LOCK_DIR"
        mkdir "$LOCK_DIR"
    fi
    echo "$$" >"$LOCK_DIR/pid"
    LOCK_HELD=1
}

release_lock() {
    rm -rf "$LOCK_DIR"
    LOCK_HELD=0
}

relative_target() {
    case "$1" in
        "$STATE_DIR"/*) printf '%s\n' "state/${1#"$STATE_DIR"/}" ;;
        "$HOME"/*) printf '%s\n' "${1#"$HOME"/}" ;;
        *) return 1 ;;
    esac
}

target_for_relative() {
    case "$1" in
        state/*) printf '%s\n' "$STATE_DIR/${1#state/}" ;;
        *) printf '%s\n' "$HOME/$1" ;;
    esac
}

snapshot_targets() {
    printf '%s\n' \
        "$HOME/.gitconfig" \
        "$HOME/.Brewfile" \
        "$HOME/.zprofile" \
        "$HOME/.config/chezmoi/chezmoi.toml" \
        "$HOME/Library/LaunchAgents/com.chezmoi.mac-dotfiles.maintenance.plist" \
        "$STATE_DIR/schema-version"
}

allowed_relative_targets() {
    local target
    while IFS= read -r target; do
        relative_target "$target"
    done < <(snapshot_targets)
}

is_allowed_relative() {
    local candidate="$1" allowed
    while IFS= read -r allowed; do
        [[ "$candidate" != "$allowed" ]] || return 0
    done < <(allowed_relative_targets)
    return 1
}

encrypt_archive() {
    local source="$1" destination="$2"
    if [[ -n "${MAC_DOTFILES_RECOVERY_PASSWORD_FILE:-}" ]]; then
        [[ -f "$MAC_DOTFILES_RECOVERY_PASSWORD_FILE" ]] || die "Recovery password file does not exist"
        openssl enc -aes-256-cbc -salt -pbkdf2 -pass "file:$MAC_DOTFILES_RECOVERY_PASSWORD_FILE" -in "$source" -out "$destination"
    else
        openssl enc -aes-256-cbc -salt -pbkdf2 -in "$source" -out "$destination"
    fi
}

decrypt_archive() {
    local source="$1" destination="$2"
    if [[ -n "${MAC_DOTFILES_RECOVERY_PASSWORD_FILE:-}" ]]; then
        [[ -f "$MAC_DOTFILES_RECOVERY_PASSWORD_FILE" ]] || die "Recovery password file does not exist"
        openssl enc -d -aes-256-cbc -pbkdf2 -pass "file:$MAC_DOTFILES_RECOVERY_PASSWORD_FILE" -in "$source" -out "$destination"
    else
        openssl enc -d -aes-256-cbc -pbkdf2 -in "$source" -out "$destination"
    fi
}

build_snapshot() {
    local work="$1" target relative destination checksum
    mkdir -p "$work/payload" "$work/inventory"
    : >"$work/checksums.sha256"
    : >"$work/files.txt"

    while IFS= read -r target; do
        [[ -f "$target" || -L "$target" ]] || continue
        relative="$(relative_target "$target")"
        destination="$work/payload/$relative"
        mkdir -p "$(dirname "$destination")"
        cp -a "$target" "$destination"
        checksum="$(sha256_file "$destination")"
        printf '%s  payload/%s\n' "$checksum" "$relative" >>"$work/checksums.sha256"
        printf '%s\n' "$relative" >>"$work/files.txt"
    done < <(snapshot_targets)

    if command -v brew >/dev/null 2>&1; then
        brew leaves 2>/dev/null | sort >"$work/inventory/brew-formulae.txt" || :
        brew list --cask 2>/dev/null | sort >"$work/inventory/brew-casks.txt" || :
    else
        : >"$work/inventory/brew-formulae.txt"
        : >"$work/inventory/brew-casks.txt"
    fi
    sha256_file "$work/inventory/brew-formulae.txt" | awk '{print $1 "  inventory/brew-formulae.txt"}' >>"$work/checksums.sha256"
    sha256_file "$work/inventory/brew-casks.txt" | awk '{print $1 "  inventory/brew-casks.txt"}' >>"$work/checksums.sha256"

    jq -n \
        --argjson schema_version "$FORMAT_VERSION" \
        --arg created_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        --arg host "$(scutil --get ComputerName 2>/dev/null || hostname)" \
        --arg architecture "$(uname -m)" \
        --arg macos "$(sw_vers -productVersion 2>/dev/null || uname -s)" \
        --arg profile "$(chezmoi data 2>/dev/null | jq -r '.profile // "full"' 2>/dev/null || echo full)" \
        --arg repo_commit "$(git -C "$HOME/.local/share/chezmoi" rev-parse HEAD 2>/dev/null || echo unknown)" \
        --argjson file_count "$(wc -l <"$work/files.txt" | tr -d ' ')" \
        '{schema_version:$schema_version,kind:"mac-dotfiles-recovery",created_at:$created_at,source:{host:$host,architecture:$architecture,macos:$macos,profile:$profile,repo_commit:$repo_commit},file_count:$file_count,secrets_included:false}' \
        >"$work/manifest.json"
}

create_snapshot() {
    local output="" work archive id
    while (($#)); do
        case "$1" in
            --output)
                [[ $# -ge 2 ]] || die "Missing value for --output" 2
                output="$2"
                shift
                ;;
            --encrypt) ENCRYPT=1 ;;
            -h | --help)
                usage
                return
                ;;
            *) die "Unknown create option: $1" 2 ;;
        esac
        shift
    done
    command -v jq >/dev/null 2>&1 || die "jq is required"
    id="$(date '+%Y%m%d-%H%M%S')"
    mkdir -p "$SNAPSHOT_DIR"
    output="${output:-$SNAPSHOT_DIR/mac-dotfiles-$id.tar.gz}"
    [[ "$ENCRYPT" -eq 0 || "$output" == *.enc ]] || output="$output.enc"
    new_temp_dir mac-dotfiles-recovery
    work="$NEW_TEMP_DIR"
    build_snapshot "$work"
    archive="$work/snapshot.tar.gz"
    tar -C "$work" -czf "$archive" manifest.json checksums.sha256 files.txt payload inventory
    mkdir -p "$(dirname "$output")"
    PARTIAL_OUTPUT="$output.tmp.$$"
    if [[ "$ENCRYPT" -eq 1 ]]; then
        command -v openssl >/dev/null 2>&1 || die "openssl is required for --encrypt"
        encrypt_archive "$archive" "$PARTIAL_OUTPUT"
    else
        cp "$archive" "$PARTIAL_OUTPUT"
    fi
    mv "$PARTIAL_OUTPUT" "$output"
    PARTIAL_OUTPUT=""
    echo "✓ Recovery snapshot created: $output"
    echo "  Secrets included: no"
}

list_snapshots() {
    local found=0 path
    echo "Recovery snapshots"
    for path in "$SNAPSHOT_DIR"/mac-dotfiles-*.tar.gz "$SNAPSHOT_DIR"/mac-dotfiles-*.tar.gz.enc; do
        [[ -f "$path" ]] || continue
        found=1
        printf '  %s\t%s\n' "$(basename "$path")" "$(du -h "$path" | awk '{print $1}')"
    done
    [[ "$found" -eq 1 ]] || echo "  No snapshots found."
}

unpack_snapshot() {
    local snapshot="$1" destination="$2" archive entry
    archive="$snapshot"
    [[ -f "$snapshot" ]] || die "Snapshot not found: $snapshot"
    if [[ "$snapshot" == *.enc ]]; then
        command -v openssl >/dev/null 2>&1 || die "openssl is required for encrypted snapshots"
        archive="$destination/decrypted.tar.gz"
        decrypt_archive "$snapshot" "$archive"
    fi
    while IFS= read -r entry; do
        case "$entry" in
            /* | ../* | */../* | */..) die "Unsafe path in recovery archive: $entry" ;;
        esac
    done < <(tar -tzf "$archive")
    tar -C "$destination" -xzf "$archive"
}

verify_unpacked() {
    local root="$1" expected file actual relative duplicates declared_count actual_count checksum_count
    jq -e '.schema_version == 1 and .kind == "mac-dotfiles-recovery" and .secrets_included == false' "$root/manifest.json" >/dev/null || die "Unsupported or invalid recovery manifest"
    declared_count="$(jq -r '.file_count' "$root/manifest.json")"
    actual_count="$(awk 'NF {count++} END {print count+0}' "$root/files.txt")"
    [[ "$declared_count" =~ ^[0-9]+$ && "$declared_count" -eq "$actual_count" ]] || die "Recovery manifest file count does not match its payload"
    duplicates="$(sort "$root/files.txt" | uniq -d)"
    [[ -z "$duplicates" ]] || die "Duplicate recovery target: $(head -n 1 <<<"$duplicates")"
    while IFS= read -r relative; do
        [[ -n "$relative" ]] || continue
        is_allowed_relative "$relative" || die "Recovery target is outside the allowlist: $relative"
        [[ -f "$root/payload/$relative" && ! -L "$root/payload/$relative" ]] || die "Recovery payload must be a regular file: $relative"
        awk -v path="payload/$relative" '$2 == path {found++} END {exit found == 1 ? 0 : 1}' "$root/checksums.sha256" || die "Missing or duplicate checksum: payload/$relative"
    done <"$root/files.txt"
    for file in inventory/brew-formulae.txt inventory/brew-casks.txt; do
        awk -v path="$file" '$2 == path {found++} END {exit found == 1 ? 0 : 1}' "$root/checksums.sha256" || die "Missing or duplicate checksum: $file"
    done
    checksum_count="$(awk 'NF {count++} END {print count+0}' "$root/checksums.sha256")"
    [[ "$checksum_count" -eq $((actual_count + 2)) ]] || die "Recovery checksum catalog contains unexpected entries"
    while read -r expected file; do
        [[ -n "$file" && -f "$root/$file" ]] || die "Snapshot payload is incomplete: $file"
        actual="$(sha256_file "$root/$file")"
        [[ "$actual" == "$expected" ]] || die "Checksum mismatch: $file"
    done <"$root/checksums.sha256"
}

with_unpacked() {
    local snapshot="$1" callback="$2" work
    shift 2
    new_temp_dir mac-dotfiles-recovery-read
    work="$NEW_TEMP_DIR"
    unpack_snapshot "$snapshot" "$work"
    verify_unpacked "$work"
    "$callback" "$work" "$snapshot" "$@"
}

inspect_unpacked() {
    local root="$1" snapshot="$2" files
    files="$(jq -Rsc 'split("\n") | map(select(length > 0))' "$root/files.txt")"
    jq --arg snapshot "$snapshot" --argjson files "$files" '. + {snapshot:$snapshot,files:$files}' "$root/manifest.json"
}

verify_command() {
    echo "✓ Recovery snapshot verified: $2"
}

restore_unpacked() {
    local root="$1" snapshot="$2" dry_run="$3" relative target backup_root restored=0 restore_failed=0
    echo "Recovery restore plan"
    echo "Snapshot: $snapshot"
    while IFS= read -r relative; do
        [[ -n "$relative" ]] || continue
        target="$(target_for_relative "$relative")"
        echo "  $target"
        restored=$((restored + 1))
    done <"$root/files.txt"
    [[ "$restored" -gt 0 ]] || die "Snapshot contains no restorable files"
    [[ "$dry_run" -eq 0 ]] || {
        echo "Dry run complete; no files changed."
        return
    }
    if [[ "$ASSUME_YES" -ne 1 ]]; then
        [[ -t 0 ]] || die "Interactive confirmation required; rerun with --yes"
        printf 'Restore %d file(s)? [y/N] ' "$restored"
        IFS= read -r answer
        [[ "$answer" =~ ^(y|Y|yes|YES)$ ]] || {
            echo "Restore cancelled."
            return
        }
    fi
    acquire_lock
    backup_root="$STATE_DIR/recovery-rollbacks/$(date '+%Y%m%d-%H%M%S')-$$"
    mkdir -p "$backup_root/current"
    : >"$backup_root/present.txt"
    cp "$root/files.txt" "$backup_root/files.txt"
    while IFS= read -r relative; do
        [[ -n "$relative" ]] || continue
        target="$(target_for_relative "$relative")"
        if [[ -e "$target" || -L "$target" ]]; then
            mkdir -p "$backup_root/current/$(dirname "$relative")"
            cp -a "$target" "$backup_root/current/$relative"
            echo "$relative" >>"$backup_root/present.txt"
        fi
    done <"$root/files.txt"
    while IFS= read -r relative; do
        [[ -n "$relative" ]] || continue
        target="$(target_for_relative "$relative")"
        if [[ -d "$target" && ! -L "$target" ]]; then
            restore_failed=1
            break
        fi
        mkdir -p "$(dirname "$target")"
        rm -f "$target"
        if ! cp -a "$root/payload/$relative" "$target"; then
            restore_failed=1
            break
        fi
    done <"$root/files.txt"
    if [[ "$restore_failed" -eq 1 ]]; then
        while IFS= read -r relative; do
            [[ -n "$relative" ]] || continue
            target="$(target_for_relative "$relative")"
            rm -f "$target"
            if grep -Fqx "$relative" "$backup_root/present.txt"; then
                mkdir -p "$(dirname "$target")"
                cp -a "$backup_root/current/$relative" "$target"
            fi
        done <"$root/files.txt"
        release_lock
        die "Restore failed; original files were restored"
    fi
    release_lock
    echo "✓ Restore completed. Previous state: $backup_root"
    echo "Homebrew inventories are advisory; run mac-dotfiles.sh converge to reconcile packages."
}

restore_command() {
    local snapshot="" dry_run=0
    while (($#)); do
        case "$1" in
            --dry-run) dry_run=1 ;;
            --yes) ASSUME_YES=1 ;;
            -*) die "Unknown restore option: $1" 2 ;;
            *)
                [[ -z "$snapshot" ]] || die "Only one snapshot can be restored" 2
                snapshot="$1"
                ;;
        esac
        shift
    done
    [[ -n "$snapshot" ]] || die "A snapshot path is required" 2
    with_unpacked "$snapshot" restore_unpacked "$dry_run"
}

command="${1:-help}"
shift || true
case "$command" in
    create) create_snapshot "$@" ;;
    list) list_snapshots ;;
    inspect)
        [[ $# -eq 1 ]] || die "inspect requires one snapshot" 2
        with_unpacked "$1" inspect_unpacked
        ;;
    verify)
        [[ $# -eq 1 ]] || die "verify requires one snapshot" 2
        with_unpacked "$1" verify_command
        ;;
    restore) restore_command "$@" ;;
    help | -h | --help) usage ;;
    *) die "Unknown recovery command: $command" 2 ;;
esac
