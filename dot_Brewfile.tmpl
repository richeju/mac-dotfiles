{{- $profile := index . "profile" | default "full" -}}
{{- $catalog := include "profiles/catalog.json" | fromJson -}}
{{- if ne (int $catalog.schema_version) 1 -}}{{- fail "Invalid profile catalog schema version" -}}{{- end -}}
{{- $selected := dict -}}
{{- range $catalog.profiles -}}
{{- if eq .name $profile -}}
{{- if $selected -}}{{- fail (printf "Duplicate profile '%s'" $profile) -}}{{- end -}}
{{- $selected = . -}}
{{- end -}}
{{- end -}}
{{- if not $selected -}}{{- fail (printf "Unknown profile '%s'" $profile) -}}{{- end -}}
{{- if not $selected.components -}}{{- fail "Profile has no components" -}}{{- end -}}
{{- $seen := dict -}}
{{- range $selected.components -}}
{{- if not (regexMatch "^[a-z][a-z0-9-]*$" .) -}}{{- fail "Invalid profile component name" -}}{{- end -}}
{{- if hasKey $seen . -}}{{- fail "Duplicate profile component" -}}{{- end -}}
{{- $_ := set $seen . true -}}
{{- end -}}
# Generated profile: {{ $profile }}
{{ range $selected.components }}{{ include (printf "profiles/%s.Brewfile" .) }}{{ "\n" }}{{ end -}}
